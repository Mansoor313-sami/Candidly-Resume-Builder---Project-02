# Firebase web app config (public — safe to expose in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Gemini AI (server-only secret — never exposed to the browser)
GEMINI_API_KEY=
# Optional: force a specific model. If left blank, the app auto-detects a
# model your key can use (tries common ones, then asks the API).
# Examples: gemini-1.5-flash, gemini-2.0-flash, gemini-2.5-flash
GEMINI_MODEL=

# Your deployed site URL (used for Open Graph / share metadata)
NEXT_PUBLIC_SITE_URL=

# OPTIONAL — Firebase Admin service account. If set, public resume pages are
# server-rendered for better SEO + per-resume link previews. Leave blank to
# skip (the app falls back to client-side rendering and still works).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
